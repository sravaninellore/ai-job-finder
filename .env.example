# Environment variables example

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_finder_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend URL for SQLite local fallback if Postgres not running
DATABASE_URL=sqlite:///./job_finder.db

# LLM Providers (Provide at least one for AI parsing, fallback rule engine will be used if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email & Alert Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Backend Config
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_DIR=./uploads
